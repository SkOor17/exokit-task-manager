// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// USER MODELS
// ========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  lastName  String   
  firstName String?  
  role      Role     @default(OPERATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks  Task[]
  timers Timer[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

// ========================================
// CUSTOMER CASE / PROJECT MODELS
// ========================================

model ProjectCase {
  id            String       @id @default(uuid())
  orderNumber   String       @unique 
  customer      String       
  description   String?
  status        CaseStatus   @default(IN_PROGRESS)
  createdDate   DateTime     @default(now()) 
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  tasks Task[]

  @@map("project_cases")
}

enum CaseStatus {
  IN_PROGRESS
  PENDING
  COMPLETED
  DELIVERED
}

// ========================================
// TASK MODELS
// ========================================

model Task {
  id              String     @id @default(uuid())
  title           String     
  description     String?
  type            TaskType
  priority        Int        @default(0) // 0=low, 1=medium, 2=high, 3=critical
  status          TaskStatus @default(TO_DO)
  dueDate         DateTime?  // "dateEcheance"
  
  // Time (in decimal hours)
  laborTime       Float      @default(0) // "tempsHumain"
  machineTime     Float      @default(0) // "tempsMachine"
  oilingTime      Float      @default(0) // "tempsHuilage"
  
  // Estimates (optional)
  estimatedLaborTime   Float?
  estimatedMachineTime  Float?
  estimatedOilingTime   Float?
  
  kitDescription  String?
  completionNote  String? // Note added at the end of the task
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  caseId      String
  projectCase ProjectCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  operatorId  String?
  operator    User?       @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  timers            Timer[]
  checklists        Checklist[]
  productionOrder   ProductionOrder?

  @@map("tasks")
  @@index([status])
  @@index([type])
  @@index([operatorId])
  @@index([caseId])
}

enum TaskType {
  PO         // Production Order (Ordre de fabrication)
  ASSEMBLY
  FINISHING
  OILING
  PACKAGING
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  VALIDATED
}

// ========================================
// PRODUCTION ORDER MODELS
// ========================================

model ProductionOrder {
  id        String   @id @default(uuid())
  number    String   @unique
  parts     Json     // { name, quantity, dimensions, etc. }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-1 Relation with Task
  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("production_orders")
}

// ========================================
// TIMER MODELS
// ========================================

model Timer {
  id        String    @id @default(uuid())
  startTime DateTime  @default(now()) 
  endTime   DateTime? 
  duration  Int?      
  isPaused  Boolean   @default(false)
  note      String?   

  // Time category
  timeType TimeType @default(LABOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("timers")
  @@index([taskId])
  @@index([userId])
}

enum TimeType {
  LABOR
  MACHINE
  OILING
}

// ========================================
// CHECKLIST MODELS
// ========================================

model Checklist {
  id          String   @id @default(uuid())
  title       String
  items       Json     // [{ id, label, checked }]
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("checklists")
}