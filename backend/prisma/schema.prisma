// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// USER MODELS
// ========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  lastName  String   
  firstName String?  
  role      Role     @default(OPERATOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tasks  Task[]
  timers Timer[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

// ========================================
// WORK ORDER (OF) MODELS
// ========================================

/// Work Order = Ordre de Fabrication (OF)
/// This is the main project/order for a client
/// Contains all specifications, BOM, and planning
model WorkOrder {
  id                String          @id @default(uuid())
  orderNumber       String          @unique // Numéro OF (ex: OF-2026-001)
  customerName      String
  productType       String?         // Type de produit (fenêtre, escalier, porte)
  description       String?
  status            WorkOrderStatus @default(PENDING)
  
  // Dates
  orderDate         DateTime        @default(now())
  expectedDelivery  DateTime?
  actualDelivery    DateTime?
  
  // Technical specs
  specifications    Json?           // Specs techniques détaillées
  
  // Bill of Materials (BOM)
  billOfMaterials   Json?            // Liste des matériaux/composants
  
  // Pricing
  estimatedCost     Float?
  actualCost        Float?
  sellingPrice      Float?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  tasks             Task[]

  @@map("work_orders")
  @@index([status])
  @@index([orderNumber])
  @@index([customerName])
}

enum WorkOrderStatus {
  PENDING           // En attente
  IN_PROGRESS       // En cours
  ON_HOLD           // En pause
  COMPLETED         // Terminé
  DELIVERED         // Livré
  CANCELLED         // Annulé
}

// ========================================
// TASK MODELS
// ========================================

/// Task = Une étape de production
/// Chaque WorkOrder se décompose en plusieurs Tasks
model Task {
  id                String      @id @default(uuid())
  title             String
  description       String?
  type              TaskType    // Type d'opération
  priority          Int         @default(0) // 0=low, 1=medium, 2=high, 3=critical
  status            TaskStatus  @default(TODO)
  
  // Dates
  dueDate           DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  
  // Time tracking (in hours - decimal)
  estimatedHumanTime    Float?  // Temps estimé humain
  estimatedMachineTime  Float?  // Temps estimé machine
  estimatedOilingTime   Float?  // Temps estimé huilage
  
  actualHumanTime       Float   @default(0) // Temps réel humain
  actualMachineTime     Float   @default(0) // Temps réel machine
  actualOilingTime      Float   @default(0) // Temps réel huilage
  
  // Additional info
  kitDescription    String?     // Description du kit/setup
  completionNotes   String?     // Notes à la fin de la tâche
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  workOrderId       String
  workOrder         WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  assignedToId      String?
  assignedTo        User?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  timers            Timer[]
  checklists        Checklist[]

  @@map("tasks")
  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([workOrderId])
  @@index([dueDate])
}

enum TaskType {
  CUTTING           // Découpe
  MACHINING         // Usinage CNC
  ASSEMBLY          // Assemblage
  FINISHING         // Finition
  OILING            // Huilage
  PACKAGING         // Emballage
  QUALITY_CHECK     // Contrôle qualité
}

enum TaskStatus {
  TODO              // À faire
  IN_PROGRESS       // En cours
  PAUSED            // En pause
  COMPLETED         // Terminée
  VALIDATED         // Validée
}

// ========================================
// TIMER MODELS
// ========================================

model Timer {
  id          String    @id @default(uuid())
  startTime   DateTime  @default(now())
  endTime     DateTime?
  duration    Int?      // Duration in seconds
  isPaused    Boolean   @default(false)
  notes       String?   // Optional notes at end
  
  // Type of time being tracked
  timeType    TimeType  @default(HUMAN)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("timers")
  @@index([taskId])
  @@index([userId])
  @@index([startTime])
}

enum TimeType {
  HUMAN         // Temps humain
  MACHINE       // Temps machine
  OILING        // Temps huilage
}

// ========================================
// CHECKLIST MODELS
// ========================================

model Checklist {
  id          String   @id @default(uuid())
  title       String
  items       Json     // Array of { id, label, checked, required }
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("checklists")
}